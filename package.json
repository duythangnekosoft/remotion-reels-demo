{
  "name": "remotion-reels-demo",
  "version": "1.0.0",
  "description": "Viral FB Reels & TikTok templates for Quiz, Games, and ASMR in Remotion",
  "scripts": {
    "start": "remotion preview src/index.ts --port 3100",
    "start:3001": "remotion preview src/index.ts --port 3001",
    "start:3100": "remotion preview src/index.ts --port 3100",
    "build:quiz": "remotion render src/index.ts USGeographyQuiz out/quiz.mp4",
    "build:barchart": "remotion render src/index.ts BarChartRaceTech out/barchart.mp4",
    "build:billionaires": "remotion render src/index.ts BillionairesRace out/billionaires.mp4",
    "build:biblequiz": "remotion render src/index.ts BibleTriviaQuiz out/bible_quiz.mp4",
    "build:chat": "remotion render src/index.ts ChatDramaStory out/chat_drama.mp4",
    "build:nostalgia": "remotion render src/index.ts NostalgiaQuiz out/nostalgia_quiz.mp4",
    "build:laws": "remotion render src/index.ts CrazyLawsQuiz out/crazy_laws.mp4",
    "build:all": "node scripts/render-all.js",
    "build:tts": "node scripts/batch-generate-audio.js",
    "render:chat": "node scripts/render-fleet.js --topic=chat",
    "render:bible": "node scripts/render-fleet.js --topic=bible",
    "render:nostalgia": "node scripts/render-fleet.js --topic=nostalgia",
    "render:laws": "node scripts/render-fleet.js --topic=laws",
    "render:geography": "node scripts/render-fleet.js --topic=geography",
    "render:marble": "node scripts/render-fleet.js --topic=marble",
    "render:territory": "node scripts/render-fleet.js --topic=territory",
    "render:plinko": "node scripts/render-fleet.js --topic=plinko",
    "render:wyr": "node scripts/render-fleet.js --topic=wyr",
    "render:kinetic": "node scripts/render-kinetic.js",
    "render:fleet": "node scripts/render-fleet.js --all",
    "test": "node scripts/verify-timelines.js && node --test scripts/*.test.js",
    "verify": "node scripts/verify-timelines.js",
    "audio:measure": "node scripts/measure-audio.js",
    "test:regression": "node --test scripts/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.260"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.260",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
